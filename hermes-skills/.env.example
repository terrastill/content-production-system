# Copy to the new machine's Hermes runtime environment; do not commit real values.

# External vector retrieval adapter. AnythingLLM is intentionally not required.
VECTOR_STORE_BASE_URL=
VECTOR_STORE_RETRIEVAL_PATH=/v1/retrieve
VECTOR_STORE_API_KEY=
VECTOR_STORE_AUTH_SCHEME=Bearer
VECTOR_STORE_COLLECTION=
VECTOR_STORE_TIMEOUT_SECONDS=30

# ChatGPT/OpenAI-compatible article model adapter.
ARTICLE_MODEL_BASE_URL=https://api.openai.com/v1
ARTICLE_MODEL_CHAT_PATH=/chat/completions
ARTICLE_MODEL_API_KEY=
ARTICLE_MODEL_AUTH_SCHEME=Bearer
ARTICLE_MODEL_NAME=
ARTICLE_MODEL_TIMEOUT_SECONDS=90

# CMS publishing adapter. Password/token must only exist in the machine's secure runtime environment.
CMS_BASE_URL=
CMS_LOGIN_URL=
CMS_SERVICE_USERNAME=
CMS_SERVICE_PASSWORD=
CMS_AUTH_MODE=browser_session
CMS_API_TOKEN=
CMS_DRAFT_ENDPOINT=
CMS_PUBLISH_ENDPOINT=
CMS_MEDIA_ENDPOINT=
CMS_VERIFY_ENDPOINT=
CMS_TIMEOUT_SECONDS=45
