# Runtime secrets and endpoints. Never commit this file.
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/data/content.sqlite3
MEDIA_ROOT=/data/media

# AnythingLLM: only the approved workspace may be queried.
ANYTHINGLLM_BASE_URL=http://host.docker.internal:3001
ANYTHINGLLM_WORKSPACE_SLUG=doing
ANYTHINGLLM_API_KEY=

# CMS service account: use a dedicated account with draft/create/read permissions only.
CMS_BASE_URL=https://www.charcoalmakingplant.com
CMS_API_TOKEN=
CMS_DRAFT_ENDPOINT=
CMS_PUBLISH_ENDPOINT=
CMS_CATEGORY_ID=

# Optional LLM provider used by the generation adapter.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
