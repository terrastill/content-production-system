# Runtime secrets and endpoints. Never commit this file.
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/data/content.sqlite3
MEDIA_ROOT=/data/media

# Optional server vector store; AnythingLLM is not called by this app.
VECTOR_STORE_BASE_URL=
VECTOR_STORE_RETRIEVAL_PATH=/v1/retrieve
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=

# Optional OpenAI-compatible article model.
ARTICLE_MODEL_BASE_URL=
ARTICLE_MODEL_CHAT_PATH=/chat/completions
ARTICLE_MODEL_API_KEY=
ARTICLE_MODEL_NAME=

# CMS. Passwords/tokens are runtime-only and never returned by the UI.
CMS_BASE_URL=
CMS_LOGIN_URL=
CMS_SERVICE_USERNAME=
CMS_SERVICE_PASSWORD=
CMS_API_TOKEN=
CMS_DRAFT_ENDPOINT=
CMS_PUBLISH_ENDPOINT=
CMS_MEDIA_ENDPOINT=
CMS_VERIFY_ENDPOINT=
